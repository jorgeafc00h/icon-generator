{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environment": {
      "value": "dev"
    },
    "baseName": {
      "value": "icongen"
    },
    "databaseType": {
      "value": "cosmosdb",
      "metadata": {
        "description": "Using Cosmos DB Free Tier: 1000 RU/s + 25GB free forever"
      }
    },
    "sqlAdminPassword": {
      "value": "",
      "metadata": {
        "description": "Not needed when using Cosmos DB"
      }
    },
    "stripeSecretKey": {
      "value": "",
      "metadata": {
        "description": "Add Stripe secret key for payment processing"
      }
    },
    "stripeWebhookSecret": {
      "value": "",
      "metadata": {
        "description": "Add Stripe webhook secret for payment webhooks"
      }
    },
    "googleClientId": {
      "value": "",
      "metadata": {
        "description": "Add Google OAuth Client ID for authentication"
      }
    },
    "frontendUrl": {
      "value": "http://localhost:5173",
      "metadata": {
        "description": "Frontend URL for Stripe redirects (update for production)"
      }
    },
    "tags": {
      "value": {
        "Environment": "Development",
        "Project": "IconGenerator",
        "ManagedBy": "Bicep",
        "CostCenter": "Engineering"
      }
    }
  }
}
